[0.001, "o", "\u001b[32m╭──────────────────────────────────────────────────────────────────────────────╮\u001b[0m\r\n\u001b[32m│\u001b[0m \u001b[1;32mSame engine, same Cypher — scales to all 575K studies and 27M edges\u001b[0m          \u001b[32m│\u001b[0m\r\n\u001b[32m│\u001b[0m and federates with pubmed-kg / druginteractions-kg on shared MeSH & drug     \u001b[32m│\u001b[0m\r\n\u001b[32m│\u001b[0m identifiers.                                                                 \u001b[32m│\u001b[0m\r\n\u001b[32m╰──────────────────────────────────────────────────────────────────────────────╯\u001b[0m\r\n"]
